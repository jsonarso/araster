---
import MobileNav from "./MobileNav.tsx";
import WhatsAppButton from "./WhatsAppButton.astro";
import { SITE, WHATSAPP_MESSAGES } from "@/config/site";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/catalogo", label: "Catálogo" },
  { href: "/sobre-nosotros", label: "Sobre Nosotros" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-(--color-border) bg-(--color-bg)/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-mono text-lg font-bold tracking-tight text-(--color-fg)">
      <span class="text-(--color-accent)">▚</span>
      {SITE.name}
    </a>

    <nav class="hidden items-center gap-6 font-mono text-sm md:flex" aria-label="Navegación principal">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "transition-colors hover:text-(--color-accent)",
            currentPath === link.href ? "text-(--color-accent)" : "text-(--color-muted)",
          ]}
          aria-current={currentPath === link.href ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <WhatsAppButton message={WHATSAPP_MESSAGES.general} size="md" />
    </div>

    <MobileNav links={links} client:load />
  </div>
</header>
