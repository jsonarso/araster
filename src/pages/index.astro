---
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/ProductCard.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { SITE, WHATSAPP_MESSAGES } from "@/config/site";
import { listProducts, listCollections, getEnv } from "@/lib/products";

export const prerender = false;

const env = getEnv();
const [allProducts, collections] = await Promise.all([listProducts(env), listCollections(env)]);
const featured = allProducts.filter((p) => p.featured).slice(0, 6);
---

<Layout title={SITE.name} description={SITE.description}>
  <section class="relative overflow-hidden border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <div class="max-w-2xl">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-(--color-accent)">
          PAT. Nº AR-03D — "SISTEMA DE FABRICACIÓN ADITIVA"
        </p>
        <h1 class="mt-4 text-5xl font-semibold leading-[1.08] text-(--color-fg) sm:text-6xl">
          Un objeto, dibujado capa por capa hasta volverse <span class="thermal-text">real</span>.
        </h1>
        <p class="mt-6 max-w-lg text-lg text-(--color-muted)">
          Impresión 3D a medida. Piezas funcionales, decorativas y personalizadas — consultá por
          WhatsApp y te respondemos rápido.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/catalogo"
            class="inline-flex items-center gap-2 bg-(--color-fg) px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-[0.08em] text-(--color-bg) hover:bg-(--color-accent) hover:text-(--color-bg)"
          >
            Ver catálogo
          </a>
          <WhatsAppButton message={WHATSAPP_MESSAGES.general} size="lg" />
        </div>
      </div>

      <div class="diagram-panel absolute right-6 top-16 hidden w-72 lg:block">
        <svg viewBox="0 0 300 300" class="w-full">
          <defs>
            <linearGradient id="thermal" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#2b6cff" />
              <stop offset="30%" stop-color="#00d4ff" />
              <stop offset="55%" stop-color="#27e0a0" />
              <stop offset="75%" stop-color="#fbe13d" />
              <stop offset="100%" stop-color="#ff8a3d" />
            </linearGradient>
          </defs>
          <circle cx="150" cy="140" r="90" fill="none" stroke="var(--color-border)" stroke-width="1" />
          <circle
            cx="150"
            cy="140"
            r="55"
            fill="none"
            stroke="url(#thermal)"
            stroke-width="1.5"
            stroke-dasharray="4 4"
          />
          <line x1="150" y1="20" x2="150" y2="260" stroke="var(--color-accent)" stroke-width="1" />
          <line x1="30" y1="140" x2="270" y2="140" stroke="var(--color-accent)" stroke-width="1" />
          <rect
            x="120"
            y="110"
            width="60"
            height="60"
            fill="none"
            stroke="url(#thermal)"
            stroke-width="2"
            transform="rotate(20 150 140)"
          />
          <text x="150" y="225" text-anchor="middle" font-family="Courier Prime" font-size="9" fill="var(--color-fg)">
            Ø 180MM
          </text>
        </svg>
        <p class="fig-label border-t border-(--color-border) py-2 text-center">FIG. 1 — VISTA EN PLANTA</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold text-(--color-fg) sm:text-3xl">Piezas destacadas</h2>
        <p class="mt-2 text-(--color-muted)">Una muestra de lo que podemos imprimir para vos.</p>
      </div>
      <a href="/catalogo" class="hidden shrink-0 font-mono text-xs uppercase tracking-wider text-(--color-accent) hover:underline sm:block">
        Ver todo →
      </a>
    </div>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((product, i) => <ProductCard product={product} index={i + 1} collections={collections} />)}
    </div>
    <a
      href="/catalogo"
      class="mt-8 block text-center font-mono text-xs uppercase tracking-wider text-(--color-accent) hover:underline sm:hidden"
    >
      Ver todo el catálogo →
    </a>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6">
    <h2 class="text-2xl font-semibold text-(--color-fg) sm:text-3xl">¿Tenés una idea en mente?</h2>
    <p class="mx-auto mt-3 max-w-xl text-(--color-muted)">
      Contanos qué necesitás imprimir y te asesoramos sobre material, tamaño y tiempos.
    </p>
    <div class="mt-6 flex justify-center">
      <WhatsAppButton message={WHATSAPP_MESSAGES.general} size="lg" />
    </div>
  </section>
</Layout>
