---
import Layout from "@/layouts/Layout.astro";
import AdminProductForm from "@/components/AdminProductForm.tsx";
import { CATEGORIES } from "@/config/site";
import { getProduct, listCollections, getEnv } from "@/lib/products";

export const prerender = false;

const { slug } = Astro.params;
const env = getEnv();
const product = slug ? await getProduct(env, slug) : null;
const collections = await listCollections(env);

if (!product) {
  return new Response("Producto no encontrado.", { status: 404 });
}
---

<Layout title={`Editar ${product.name} · Admin`} noIndex>
  <section class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
    <a href="/admin" class="font-mono text-xs text-(--color-muted) hover:text-(--color-accent)">
      ← Volver
    </a>
    <div class="mt-3 flex items-center justify-between gap-4">
      <h1 class="text-2xl font-semibold text-(--color-fg)">Editar producto</h1>
      <button
        type="button"
        data-delete-slug={product.slug}
        class="font-mono text-xs text-red-400 hover:underline"
      >
        Eliminar producto
      </button>
    </div>

    <div class="mt-8">
      <AdminProductForm mode="edit" categories={CATEGORIES} tags={collections} initialProduct={product} client:load />
    </div>
  </section>
</Layout>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-delete-slug]");
  btn?.addEventListener("click", async () => {
    const slug = btn.dataset.deleteSlug;
    if (!slug) return;
    if (!confirm("¿Seguro que querés eliminar este producto? Esta acción no se puede deshacer.")) return;
    const res = await fetch(`/api/admin/products/${slug}`, { method: "DELETE" });
    if (res.ok) {
      window.location.href = "/admin";
    } else {
      alert("No se pudo eliminar el producto.");
    }
  });
</script>
