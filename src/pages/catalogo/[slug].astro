---
import Layout from "@/layouts/Layout.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import Gallery from "@/components/Gallery.tsx";
import ProductCard from "@/components/ProductCard.astro";
import { CATEGORIES, WHATSAPP_MESSAGES, whatsappLink } from "@/config/site";
import { getProduct, listProducts, listCollections, photoUrl, getEnv } from "@/lib/products";
import { availableColors, listFilaments } from "@/lib/filaments";
import { formatCrc } from "@/lib/pricing";

export const prerender = false;

const { slug } = Astro.params;
const env = getEnv();
const product = slug ? await getProduct(env, slug) : null;

if (!product) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const { name, category, shortDescription, description, photos, material, size, tags, price } = product;

const collections = await listCollections(env);
const categoryInfo = CATEGORIES.find((c) => c.slug === category);
const tagLabels = tags.map((t) => collections.find((c) => c.slug === t)?.label ?? t);

const galleryPhotos = photos.map((photo) => ({ src: photoUrl(photo.key), alt: photo.alt }));
const descriptionParagraphs = description.split(/\n\s*\n/).filter((p) => p.trim());

const specs = [
  { label: "Material", value: material },
  { label: "Tamaño", value: size },
].filter((s) => s.value);

const colors = availableColors(product, await listFilaments(env));
const colorLinks = colors.map((c) => whatsappLink(WHATSAPP_MESSAGES.productWithColor(name, c.name)));

const allProducts = await listProducts(env);
const related = allProducts
  .filter((p) => p.category === category && p.slug !== product.slug)
  .slice(0, 3);
---

<Layout title={name} description={shortDescription} image={galleryPhotos[0].src}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <nav class="mb-6 font-mono text-xs text-(--color-muted)" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-(--color-accent)">Inicio</a>
      <span class="mx-2">/</span>
      <a href="/catalogo" class="hover:text-(--color-accent)">Catálogo</a>
      <span class="mx-2">/</span>
      <span class="text-(--color-fg)">{name}</span>
    </nav>

    <div class="grid gap-10 md:grid-cols-2">
      <Gallery photos={galleryPhotos} client:load />

      <div class="flex flex-col gap-4">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="w-fit border border-(--color-accent) px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-(--color-accent)">
            {categoryInfo?.label ?? category}
          </span>
          {tagLabels.map((label) => (
            <span class="w-fit border border-(--color-border) px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-(--color-muted)">
              {label}
            </span>
          ))}
        </div>
        <h1 class="text-3xl font-semibold text-(--color-fg) sm:text-4xl">{name}</h1>
        <p class="text-(--color-muted)">{shortDescription}</p>
        {price && <p class="font-mono text-xl text-(--color-accent)">{formatCrc(price)}</p>}

        {specs.length > 0 && (
          <dl class="grid grid-cols-1 gap-3 border-y border-(--color-border) py-4 sm:grid-cols-3">
            {specs.map((spec) => (
              <div>
                <dt class="font-mono text-[11px] uppercase tracking-wider text-(--color-accent)">{spec.label}</dt>
                <dd class="mt-1 text-sm text-(--color-fg)">{spec.value}</dd>
              </div>
            ))}
          </dl>
        )}

        <div class="text-sm leading-relaxed text-(--color-muted)">
          {descriptionParagraphs.map((paragraph) => <p class="mb-3">{paragraph}</p>)}
        </div>

        {colors.length > 0 && (
          <div class="mt-2" data-color-picker data-default-href={whatsappLink(WHATSAPP_MESSAGES.product(name))}>
            <span id="color-label" class="font-mono text-[11px] uppercase tracking-wider text-(--color-accent)">Color</span>
            <div class="relative mt-1 max-w-xs">
              <button
                type="button"
                data-color-button
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-labelledby="color-label"
                class="flex w-full items-center gap-3 border border-(--color-border) bg-(--color-surface) px-3 py-2 text-left text-sm text-(--color-fg) hover:border-(--color-accent)"
              >
                <span data-color-dot class="h-5 w-5 shrink-0 rounded-full border border-(--color-border) bg-transparent"></span>
                <span data-color-text class="flex-1 truncate text-(--color-muted)">Elegí un color</span>
                <span aria-hidden="true" class="text-(--color-muted)">▾</span>
              </button>
              <ul
                data-color-list
                role="listbox"
                aria-labelledby="color-label"
                hidden
                class="absolute z-10 mt-1 max-h-64 w-full overflow-auto border border-(--color-border) bg-(--color-surface) shadow-lg"
              >
                {colors.map((c, i) => (
                  <li
                    role="option"
                    tabindex="-1"
                    aria-selected="false"
                    data-name={c.name}
                    data-hex={c.hex}
                    data-href={colorLinks[i]}
                    class="flex cursor-pointer items-center gap-3 px-3 py-2 text-sm text-(--color-fg) hover:bg-(--color-border) focus:bg-(--color-border) focus:outline-none"
                  >
                    <span class="h-5 w-5 shrink-0 rounded-full border border-(--color-border)" style={`background:${c.hex}`}></span>
                    {c.name}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        )}

        <div data-wa-cta>
          <WhatsAppButton message={WHATSAPP_MESSAGES.product(name)} size="lg" class="mt-2 w-fit" />
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <div class="mt-20">
        <h2 class="text-2xl font-semibold text-(--color-fg)">Piezas relacionadas</h2>
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <ProductCard product={p} collections={collections} />)}
        </div>
      </div>
    )}
  </section>
</Layout>

<script>
  const picker = document.querySelector<HTMLElement>("[data-color-picker]");
  const cta = document.querySelector<HTMLAnchorElement>("[data-wa-cta] a");
  if (picker && cta) {
    const button = picker.querySelector<HTMLButtonElement>("[data-color-button]")!;
    const list = picker.querySelector<HTMLElement>("[data-color-list]")!;
    const dot = picker.querySelector<HTMLElement>("[data-color-dot]")!;
    const text = picker.querySelector<HTMLElement>("[data-color-text]")!;
    const options = Array.from(list.querySelectorAll<HTMLElement>('[role="option"]'));

    const setOpen = (open: boolean) => {
      list.hidden = !open;
      button.setAttribute("aria-expanded", String(open));
      if (open) (options.find((o) => o.getAttribute("aria-selected") === "true") ?? options[0])?.focus();
    };
    const select = (option: HTMLElement) => {
      options.forEach((o) => o.setAttribute("aria-selected", String(o === option)));
      dot.style.background = option.dataset.hex ?? "";
      text.textContent = option.dataset.name ?? "";
      text.classList.remove("text-(--color-muted)");
      cta.href = option.dataset.href ?? picker.dataset.defaultHref ?? cta.href;
      setOpen(false);
      button.focus();
    };

    button.addEventListener("click", () => setOpen(list.hidden));
    options.forEach((o, i) => {
      o.addEventListener("click", () => select(o));
      o.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); select(o); }
        else if (e.key === "ArrowDown") { e.preventDefault(); options[Math.min(i + 1, options.length - 1)].focus(); }
        else if (e.key === "ArrowUp") { e.preventDefault(); options[Math.max(i - 1, 0)].focus(); }
        else if (e.key === "Escape") { setOpen(false); button.focus(); }
      });
    });
    button.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); setOpen(true); }
    });
    document.addEventListener("click", (e) => {
      if (!picker.contains(e.target as Node)) setOpen(false);
    });
  }
</script>
