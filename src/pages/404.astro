---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Página no encontrada" noIndex>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-(--color-accent)">PAT. Nº 404 — NO ENCONTRADA</p>
    <h1 class="mt-3 text-4xl font-semibold text-(--color-fg)">Pieza no encontrada</h1>
    <p class="mt-4 text-(--color-muted)">
      La página que buscás no existe o fue movida. Volvé al inicio o mirá el catálogo completo.
    </p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="border border-(--color-border) px-5 py-2.5 font-mono text-xs uppercase tracking-wider text-(--color-fg) hover:border-(--color-accent) hover:text-(--color-accent)">
        Ir al inicio
      </a>
      <a href="/catalogo" class="bg-(--color-accent) px-5 py-2.5 font-mono text-xs uppercase tracking-wider text-(--color-bg) hover:bg-(--color-accent-strong)">
        Ver catálogo
      </a>
    </div>
  </section>
</Layout>
