---
import { SITE, SOCIAL, WHATSAPP_MESSAGES } from "@/config/site";
import WhatsAppButton from "./WhatsAppButton.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-(--color-border) bg-(--color-surface)">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-mono text-lg font-bold text-(--color-fg)">{SITE.name}</p>
        <p class="mt-2 max-w-xs text-sm text-(--color-muted)">{SITE.description}</p>
      </div>

      <div class="font-mono text-sm">
        <p class="mb-3 text-xs uppercase tracking-widest text-(--color-muted)">Navegación</p>
        <ul class="space-y-2">
          <li><a href="/" class="hover:text-(--color-accent)">Inicio</a></li>
          <li><a href="/catalogo" class="hover:text-(--color-accent)">Catálogo</a></li>
          <li><a href="/sobre-nosotros" class="hover:text-(--color-accent)">Sobre Nosotros</a></li>
        </ul>
      </div>

      <div>
        <p class="mb-3 font-mono text-xs uppercase tracking-widest text-(--color-muted)">Contacto</p>
        <WhatsAppButton message={WHATSAPP_MESSAGES.general} variant="outline" />
        <p class="mt-4 text-sm text-(--color-muted)">
          <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-(--color-accent)">
            Instagram
          </a>
        </p>
      </div>
    </div>

    <p class="mt-10 border-t border-(--color-border) pt-6 text-xs text-(--color-muted)">
      © {year} {SITE.name}. Todos los derechos reservados.
    </p>
  </div>
</footer>
