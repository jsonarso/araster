---
import Layout from "@/layouts/Layout.astro";
import { getEnv, listProducts } from "@/lib/products";
import { listPackaging, unitCostCrc } from "@/lib/packaging";

export const prerender = false;

const env = getEnv();
const [items, products] = await Promise.all([listPackaging(env), listProducts(env)]);
const usedBy = (id: string) => products.filter((p) => p.packaging.some((u) => u.itemId === id)).length;

const ok = Astro.url.searchParams.get("ok");
const error = Astro.url.searchParams.get("error");

// Up to 2 decimals, so ₡3,48 per bag doesn't show as ₡3.
const money = new Intl.NumberFormat("es-CR", { style: "currency", currency: "CRC", maximumFractionDigits: 2 });

const inputClass =
  "border border-(--color-border) bg-(--color-bg) px-3 py-2 text-sm text-(--color-fg) focus:border-(--color-accent) focus:outline-none";
const btnClass =
  "border border-(--color-border) px-3 py-2 font-mono text-xs uppercase tracking-wider text-(--color-fg) hover:border-(--color-accent)";
const labelText = "font-mono text-[11px] uppercase tracking-wider text-(--color-accent)";
---

<Layout title="Empaque · Admin" noIndex>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <a href="/admin" class="font-mono text-xs text-(--color-muted) hover:text-(--color-accent)">← Volver</a>
    <h1 class="mt-3 text-2xl font-semibold text-(--color-fg)">Materiales de empaque</h1>
    <p class="mt-2 text-sm text-(--color-muted)">
      Bolsas, mecate, cajas… Cargá lo que pagás por el paquete y cuántas unidades trae; el costo por unidad se calcula
      solo. Después, en cada producto, indicás cuánto usa de cada uno y se suma al precio sugerido.
    </p>

    {ok && <p class="mt-6 border border-(--color-accent) px-3 py-2 text-sm text-(--color-fg)">{ok}</p>}
    {error && <p class="mt-6 border border-red-500 px-3 py-2 text-sm text-red-500">{error}</p>}

    <form method="POST" action="/api/admin/packaging" class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <input type="hidden" name="intent" value="create" />
      <label class="col-span-2 block">
        <span class={labelText}>Nombre</span>
        <input name="name" required placeholder="Ej. Bolsa con pegafácil 5x5+2 cm" class={`${inputClass} mt-1 w-full`} />
      </label>
      <label class="block">
        <span class={labelText}>Unidad</span>
        <input name="unit" required list="units" placeholder="unidad" class={`${inputClass} mt-1 w-full`} />
        <datalist id="units"><option value="unidad" /><option value="metro" /><option value="par" /></datalist>
      </label>
      <label class="block">
        <span class={labelText}>Precio del paquete (₡)</span>
        <input name="packPrice" type="number" min="0" step="any" required placeholder="695" class={`${inputClass} mt-1 w-full`} />
      </label>
      <label class="block">
        <span class={labelText}>Cuántas trae</span>
        <input name="packQuantity" type="number" min="0" step="any" required placeholder="200" class={`${inputClass} mt-1 w-full`} />
      </label>
      <div class="col-span-2 flex items-end sm:col-span-3">
        <p class="text-xs text-(--color-muted)">
          Ej. bolsas: ₡695 por 200 unidades. Pabilo: ₡495 por 20 metros (unidad = metro).
        </p>
      </div>
      <button type="submit" class="bg-(--color-accent) px-4 py-2 font-mono text-xs uppercase tracking-wider text-(--color-bg) hover:bg-(--color-accent-strong)">
        Agregar
      </button>
    </form>

    {items.length === 0 ? (
      <p class="mt-8 text-(--color-muted)">Todavía no hay materiales de empaque.</p>
    ) : (
      <ul class="mt-8 flex flex-col gap-3">
        {items.map((it) => (
          <li class="border border-(--color-border) bg-(--color-surface) p-4">
            <form method="POST" action="/api/admin/packaging" class="grid grid-cols-2 items-end gap-3 sm:grid-cols-5">
              <input type="hidden" name="intent" value="update" />
              <input type="hidden" name="id" value={it.id} />
              <label class="col-span-2 block">
                <span class={labelText}>Nombre</span>
                <input name="name" value={it.name} required class={`${inputClass} mt-1 w-full`} />
              </label>
              <label class="block">
                <span class={labelText}>Unidad</span>
                <input name="unit" value={it.unit} required class={`${inputClass} mt-1 w-full`} />
              </label>
              <label class="block">
                <span class={labelText}>Paquete (₡)</span>
                <input name="packPrice" type="number" min="0" step="any" value={it.packPrice} required class={`${inputClass} mt-1 w-full`} />
              </label>
              <label class="block">
                <span class={labelText}>Trae</span>
                <input name="packQuantity" type="number" min="0" step="any" value={it.packQuantity} required class={`${inputClass} mt-1 w-full`} />
              </label>
              <p class="col-span-2 font-mono text-sm text-(--color-accent) sm:col-span-3">
                {money.format(unitCostCrc(it))} por {it.unit}
                <span class="ml-2 text-xs text-(--color-muted)">· usado en {usedBy(it.id)} producto{usedBy(it.id) === 1 ? "" : "s"}</span>
              </p>
              <div class="col-span-2 flex gap-2 sm:justify-end">
                <button type="submit" class={btnClass}>Guardar</button>
                <button
                  type="submit"
                  name="intent"
                  value="delete"
                  formnovalidate
                  onclick="return confirm('¿Eliminar este material?')"
                  class={`${btnClass} hover:border-red-500 hover:text-red-500`}
                >
                  Eliminar
                </button>
              </div>
            </form>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
