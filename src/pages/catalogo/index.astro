---
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/ProductCard.astro";
import { CATEGORIES } from "@/config/site";
import { listProducts, listCollections, getEnv } from "@/lib/products";

export const prerender = false;

const env = getEnv();
const [sorted, collections] = await Promise.all([listProducts(env), listCollections(env)]);

const usedTagSlugs = new Set(sorted.flatMap((p) => p.tags));
const usedTags = collections.filter((t) => usedTagSlugs.has(t.slug));
---

<Layout
  title="Catálogo"
  description="Explorá el catálogo de piezas impresas en 3D de Araster: funcionales, decorativas, juguetes y organización."
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-(--color-accent)">
      REGISTRO DE PIEZAS — ARASTER
    </p>
    <h1 class="mt-2 text-4xl font-semibold text-(--color-fg) sm:text-5xl">Catálogo</h1>
    <p class="mt-3 max-w-2xl text-(--color-muted)">
      Explorá nuestras piezas por categoría. Si algo te gusta, consultanos por WhatsApp con un click.
    </p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoría">
      <button
        type="button"
        data-category-filter="todas"
        class="category-filter-btn is-active border border-(--color-border) px-4 py-1.5 font-mono text-xs uppercase tracking-wider text-(--color-fg) transition-colors"
      >
        Todas
      </button>
      {CATEGORIES.map((cat) => (
        <button
          type="button"
          data-category-filter={cat.slug}
          class="category-filter-btn border border-(--color-border) px-4 py-1.5 font-mono text-xs uppercase tracking-wider text-(--color-fg) transition-colors"
        >
          {cat.label}
        </button>
      ))}
    </div>

    {usedTags.length > 0 && (
      <div class="mt-3 flex flex-wrap items-center gap-2" role="group" aria-label="Filtrar por colección">
        <span class="font-mono text-xs uppercase tracking-widest text-(--color-muted)">Colecciones:</span>
        <button
          type="button"
          data-tag-filter="todas"
          class="tag-filter-btn is-active border border-(--color-border) px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-(--color-fg) transition-colors"
        >
          Todas
        </button>
        {usedTags.map((tag) => (
          <button
            type="button"
            data-tag-filter={tag.slug}
            class="tag-filter-btn border border-(--color-border) px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-(--color-fg) transition-colors"
          >
            {tag.label}
          </button>
        ))}
      </div>
    )}

    <div id="product-grid" class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {sorted.map((product, i) => (
        <div data-category={product.category} data-tags={product.tags.join(",")}>
          <ProductCard product={product} index={i + 1} collections={collections} />
        </div>
      ))}
    </div>

    <p id="empty-state" class="mt-12 hidden text-center text-(--color-muted)">
      No hay piezas en esta categoría todavía.
    </p>
  </section>
</Layout>

<style>
  .category-filter-btn.is-active,
  .tag-filter-btn.is-active {
    background-color: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }
</style>

<script>
  const categoryButtons = document.querySelectorAll<HTMLButtonElement>(".category-filter-btn");
  const tagButtons = document.querySelectorAll<HTMLButtonElement>(".tag-filter-btn");
  const items = document.querySelectorAll<HTMLElement>("#product-grid > [data-category]");
  const emptyState = document.getElementById("empty-state");

  let activeCategory = "todas";
  let activeTag = "todas";

  function applyFilters() {
    let visibleCount = 0;
    items.forEach((item) => {
      const itemTags = item.dataset.tags?.split(",").filter(Boolean) ?? [];
      const matchesCategory = activeCategory === "todas" || item.dataset.category === activeCategory;
      const matchesTag = activeTag === "todas" || itemTags.includes(activeTag);
      const match = matchesCategory && matchesTag;
      item.style.display = match ? "" : "none";
      if (match) visibleCount++;
    });
    emptyState?.classList.toggle("hidden", visibleCount > 0);
  }

  categoryButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      categoryButtons.forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      activeCategory = btn.dataset.categoryFilter ?? "todas";
      applyFilters();
    });
  });

  tagButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      tagButtons.forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      activeTag = btn.dataset.tagFilter ?? "todas";
      applyFilters();
    });
  });
</script>
