---
import Layout from "@/layouts/Layout.astro";
import AdminProductForm from "@/components/AdminProductForm.tsx";
import { CATEGORIES } from "@/config/site";

import { listCollections, getEnv } from "@/lib/products";

export const prerender = false;

const collections = await listCollections(getEnv());
---

<Layout title="Nuevo producto · Admin" noIndex>
  <section class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
    <a href="/admin" class="font-mono text-xs text-(--color-muted) hover:text-(--color-accent)">
      ← Volver
    </a>
    <h1 class="mt-3 text-2xl font-semibold text-(--color-fg)">Nuevo producto</h1>

    <div class="mt-8">
      <AdminProductForm mode="create" categories={CATEGORIES} tags={collections} client:load />
    </div>
  </section>
</Layout>
