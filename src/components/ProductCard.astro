---
import { CATEGORIES, TAGS, WHATSAPP_MESSAGES } from "@/config/site";
import { photoUrl, type Product } from "@/lib/products";
import WhatsAppButton from "./WhatsAppButton.astro";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, slug, category, shortDescription, photos, tags } = product;
const categoryInfo = CATEGORIES.find((c) => c.slug === category);
const tagLabels = tags.map((t) => TAGS.find((tag) => tag.slug === t)?.label ?? t);
---

<article class="group corner-brackets flex flex-col overflow-hidden border border-(--color-border) bg-(--color-surface) transition-colors hover:border-(--color-accent)">
  <a href={`/catalogo/${slug}`} class="block overflow-hidden">
    <img
      src={photoUrl(photos[0].key)}
      alt={photos[0].alt}
      width={600}
      height={467}
      loading="lazy"
      class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </a>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="w-fit rounded-full border border-(--color-border) px-2.5 py-0.5 font-mono text-[11px] uppercase tracking-wider text-(--color-accent)">
        {categoryInfo?.label ?? category}
      </span>
      {tagLabels.map((label) => (
        <span class="w-fit rounded-full bg-(--color-surface-raised) px-2.5 py-0.5 font-mono text-[11px] uppercase tracking-wider text-(--color-muted)">
          {label}
        </span>
      ))}
    </div>
    <h3 class="font-mono text-base font-semibold text-(--color-fg)">
      <a href={`/catalogo/${slug}`} class="hover:text-(--color-accent)">
        {name}
      </a>
    </h3>
    <p class="flex-1 text-sm text-(--color-muted)">{shortDescription}</p>
    <WhatsAppButton
      message={WHATSAPP_MESSAGES.product(name)}
      size="md"
      class="mt-2 w-full justify-center"
    />
  </div>
</article>
