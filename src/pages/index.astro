---
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/ProductCard.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { SITE, WHATSAPP_MESSAGES } from "@/config/site";
import { listProducts, getEnv } from "@/lib/products";

export const prerender = false;

const allProducts = await listProducts(getEnv());
const featured = allProducts.filter((p) => p.featured).slice(0, 6);
---

<Layout title={SITE.name} description={SITE.description}>
  <section class="relative overflow-hidden border-b border-(--color-border)">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-20 sm:px-6 sm:py-28">
      <span class="font-mono text-xs uppercase tracking-[0.3em] text-(--color-accent)">
        Impresión 3D · Diseño · Prototipado
      </span>
      <h1 class="max-w-2xl font-mono text-4xl font-bold leading-tight text-(--color-fg) sm:text-6xl">
        De la Araya a la rasterización: <span class="text-(--color-accent)">Araster</span>
      </h1>
      <p class="max-w-xl text-lg text-(--color-muted)">
        Imprimimos en 3D piezas funcionales, decorativas y a medida. Mirá el catálogo y
        consultanos por WhatsApp: te respondemos rápido y sin vueltas.
      </p>
      <div class="flex flex-wrap gap-3">
        <WhatsAppButton message={WHATSAPP_MESSAGES.general} size="lg" />
        <a
          href="/catalogo"
          class="inline-flex items-center gap-2 rounded-md border border-(--color-border) px-6 py-3.5 text-base font-medium text-(--color-fg) transition-colors hover:border-(--color-accent) hover:text-(--color-accent)"
        >
          Ver catálogo
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <h2 class="font-mono text-2xl font-bold text-(--color-fg) sm:text-3xl">Piezas destacadas</h2>
        <p class="mt-2 text-(--color-muted)">Una muestra de lo que podemos imprimir para vos.</p>
      </div>
      <a href="/catalogo" class="hidden shrink-0 font-mono text-sm text-(--color-accent) hover:underline sm:block">
        Ver todo →
      </a>
    </div>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((product) => <ProductCard product={product} />)}
    </div>
    <a
      href="/catalogo"
      class="mt-8 block text-center font-mono text-sm text-(--color-accent) hover:underline sm:hidden"
    >
      Ver todo el catálogo →
    </a>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6">
    <h2 class="font-mono text-2xl font-bold text-(--color-fg) sm:text-3xl">¿Tenés una idea en mente?</h2>
    <p class="mx-auto mt-3 max-w-xl text-(--color-muted)">
      Contanos qué necesitás imprimir y te asesoramos sobre material, tamaño y tiempos.
    </p>
    <div class="mt-6 flex justify-center">
      <WhatsAppButton message={WHATSAPP_MESSAGES.general} size="lg" />
    </div>
  </section>
</Layout>
